; Pixel Farm Seasons — prototype 3D
; Open THIS directory (godot/) as a Godot 4.3+ project.
config_version=5

[application]
config/name="Pixel Farm Seasons — Fazenda 3D"
run/main_scene="res://scenes/farm_world.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
move_left={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":68)]
}
move_forward={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":83)]
}
jump={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":32)]
}
sprint={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":4194325)]
}
crouch={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":4194326)]
}
toggle_camera={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":86)]
}
